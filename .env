# 所有环境的环境变量（命名必须以 VITE_ 开头）

## 项目标题
VITE_APP_TITLE = Vue Admin Template

## 路由模式 hash 或 html5
VITE_ROUTER_HISTORY = hash

## 是否启用全局本地 Mock API（false 时所有 API 走真实后端）
VITE_USE_MOCK = true

## Swagger 文档地址（拉取后写入 script/api.json，再按内容自动识别 v2 / v3）
## 示例：http://127.0.0.1:8080/v3/api-docs 或 http://127.0.0.1:8080/v2/api-docs
SWAGGER_URL =
