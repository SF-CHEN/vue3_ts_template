{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["esnext", "dom"],
    "useDefineForClassFields": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["./src/*"],
      "@@/*": ["./src/common/*"]
    },
    "resolveJsonModule": true,
    "types": ["vite/client", "element-plus/global"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.vue", "**/*.d.ts"],
  "exclude": ["node_modules", "dist"]
}
