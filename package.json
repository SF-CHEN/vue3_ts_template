{
  "name": "vue-admin-template",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "description": "Vue 3 admin template with Vite, TypeScript, Element Plus, Pinia and UnoCSS",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build",
    "build:staging": "vue-tsc --noEmit && vite build --mode staging",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "pnpm lint && pnpm typecheck",
    "check:fix": "pnpm lint:fix && pnpm typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "init": "node script/init-project.mjs",
    "deps:update": "node script/update-deps.mjs",
    "deps:update:latest": "node script/update-deps.mjs --latest",
    "api:generate": "node script/generate-api.cjs",
    "api:doc": "node script/doc.cjs",
    "api:all": "pnpm api:generate && pnpm api:doc"
  },
  "dependencies": {
    "@vueuse/core": "15.0.0",
    "axios": "1.20.0",
    "element-plus": "2.14.6",
    "js-md5": "0.9.2",
    "normalize.css": "8.0.1",
    "nprogress": "0.2.0",
    "pinia": "4.0.3",
    "vue": "3.5.43",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.5.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@iconify-json/ep": "1.2.4",
    "@iconify-json/fa-solid": "1.2.2",
    "@types/node": "26.6.2",
    "@types/nprogress": "0.2.3",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.11.0",
    "eslint-plugin-format": "2.0.1",
    "happy-dom": "20.14.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "sass-embedded": "1.104.1",
    "typescript": "6.0.3",
    "unocss": "66.10.5",
    "unplugin-auto-import": "21.1.0",
    "unplugin-svg-component": "0.13.0",
    "unplugin-vue-components": "32.1.0",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "vue-tsc": "3.3.11"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,vue}": "eslint --fix --no-warn-ignored"
  }
}
